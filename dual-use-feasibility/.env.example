# Kopiér til .env (som er i .gitignore) og udfyld. Læg ALDRIG credentials i koden.
CVR_USER=
CVR_PASSWORD=
# Vejledningen "Kom godt igang med Elasticsearch" bruger http:// (ikke https).
CVR_BASE_URL=http://distribution.virk.dk
# Kontaktadresse, der sendes i User-Agent ved stikprøvetjek af hjemmesider.
CONTACT_EMAIL=
